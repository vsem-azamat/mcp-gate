root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.go]
indent_style = tab
indent_size = unset

[{go.mod,go.sum}]
indent_style = tab
indent_size = unset

[Makefile]
indent_style = tab
indent_size = unset

[*.md]
indent_size = unset

# The license text is kept verbatim.
[LICENSE]
indent_size = unset
