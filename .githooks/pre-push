#!/usr/bin/env bash
# The local share of CI before a push: lint, tests, tidy modules and repository checks. vuln and
# release-check need the network or take long; CI runs them. Install with `make hooks`.
set -euo pipefail
# Written for bash 3.2 (the macOS default).
cd "$(git rev-parse --show-toplevel)"

# stdin: one "<local ref> <local sha> <remote ref> <remote sha>" line per ref. A push that only
# deletes remote refs (local sha all zeros) has nothing to check.
zero=$(git hash-object --stdin </dev/null | tr '0-9a-f' '0')
update=0
while read -r _ local_sha _ _; do
  [ "$local_sha" = "$zero" ] || update=1
done
[ "$update" = 1 ] || exit 0

make lint test tidy-check repo
